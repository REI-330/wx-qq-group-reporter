# 设置默认行为：自动识别文本，提交时转为 LF
* text=auto

# --- 脚本类：强制换行符 ---
*.bat     text eol=crlf
*.sh      text eol=lf
*.py      text eol=lf

# --- 前端/代码类：强制 LF ---
*.js      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.jsx     text eol=lf
*.vue     text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.less    text eol=lf
*.html    text eol=lf
*.json    text eol=lf

# --- 文档与配置：强制 LF ---
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
*.example       text eol=lf

# --- 锁文件：保持一致性 ---
package-lock.json  text eol=lf
yarn.lock          text eol=lf
pnpm-lock.yaml     text eol=lf

# --- 二进制文件：禁止 Git 修改 ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
*.gz    binary
